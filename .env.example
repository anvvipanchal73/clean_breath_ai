# CleanBreath AI Environment Variables
# Copy this file to .env (root / backend) and frontend/.env.local as needed.
# NEVER commit real secrets.

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# --- Backend / Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# --- Privacy / Field Encryption ---
# 32-byte URL-safe base64 key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
HEALTH_DATA_ENCRYPTION_KEY=replace-with-fernet-key

# --- Gemini LLM ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# --- Air Quality APIs ---
# Open-Meteo requires no API key for standard non-commercial usage
OPEN_METEO_BASE_URL=https://air-quality-api.open-meteo.com/v1
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1
# Optional fallback keys
OPENAQ_API_KEY=
WAQI_API_TOKEN=

# --- Web Push Notifications ---
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@cleanbreath.example
